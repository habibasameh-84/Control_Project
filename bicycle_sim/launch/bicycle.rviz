          Z: 33.963096618652344
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05000000074505806
        Invert Z Axis: false
        Name: Orbit
        Near Clip Distance: 0.009999999776482582
        Pitch: 1.090000033378601
        Target Frame: ego_racecar/front_left_wheel
        Value: Orbit (rviz)
        Yaw: 1.6499996185302734
      - Class: rviz_default_plugins/Orbit
